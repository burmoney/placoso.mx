<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>My Premium T-Shirt Shop</title>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
<style>
  body { font-family: 'Roboto', Arial, sans-serif; margin:0; background:#f0f2f5; color:#333; padding:20px; }
  header { background: linear-gradient(90deg, #1a1a1a, #333); color:#fff; padding:25px 20px; text-align:center; box-shadow:0 4px 10px rgba(0,0,0,0.2); }
  header h1 { margin:0; font-weight:900; font-size:2rem; letter-spacing:1px; }
  .page { display:none; padding:40px 20px; max-width:1000px; margin:auto; background:#fff; border-radius:12px; box-shadow:0 6px 20px rgba(0,0,0,0.1); }
  .active { display:block; }
  .btn { margin:10px 0; padding:14px 25px; cursor:pointer; font-size:1rem; border-radius:6px; border:none; color:#fff; background: linear-gradient(45deg, #007bff, #0056b3); box-shadow:0 4px 8px rgba(0,0,0,0.2); transition:all 0.3s ease; }
  .btn:hover { background: linear-gradient(45deg,#0056b3,#003f7f); transform:translateY(-2px); box-shadow:0 6px 12px rgba(0,0,0,0.3); }
  .products-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:25px; }
  .product-card { background:#fff; border-radius:12px; box-shadow:0 6px 20px rgba(0,0,0,0.1); overflow:hidden; transition:all 0.3s ease; display:flex; flex-direction:column; align-items:center; }
  .product-card:hover { transform: translateY(-5px) scale(1.02); box-shadow: 0 12px 25px rgba(0,0,0,0.15); }
  .product-img { width:100%; height:auto; }
  .product-info { padding:20px; text-align:center; }
  .product-title { font-size:1.4rem; margin:10px 0; font-weight:700; }
  .product-price { font-size:1.2rem; color:#e91e63; font-weight:700; margin-bottom:15px; }
  #cartItems div { display:flex; justify-content:space-between; align-items:center; background:#fdfdfd; margin:8px 0; padding:12px; border-radius:6px; box-shadow:0 2px 6px rgba(0,0,0,0.05); }
  #cartItems button { background:none; border:none; color:#e53935; cursor:pointer; font-size:1.2rem; }
  input, select { width:100%; padding:14px; margin:8px 0 16px 0; border:1px solid #ccc; border-radius:6px; box-shadow:inset 0 2px 5px rgba(0,0,0,0.05); font-size:1rem; transition:all 0.2s ease; }
  input:focus, select:focus { border-color:#007bff; box-shadow:0 0 5px rgba(0,123,255,0.3); outline:none; }
  footer { background:#222; color:#fff; text-align:center; padding:20px; margin-top:40px; font-size:0.9rem; letter-spacing:0.5px; }
</style>
</head>
<body>

<header>
  <h1>My Premium T-Shirt Shop</h1>
</header>

<!-- PRODUCT PAGE -->
<div id="product" class="page active">
  <h2>Exclusive T-Shirts</h2>
  <div class="products-grid">
    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1602799944454-0d8f0a0b7f2b?ixlib=rb-4.0.4&auto=format&fit=crop&w=600&q=80" class="product-img" alt="Cool T-Shirt"/>
      <div class="product-info">
        <div class="product-title">Cool T-Shirt</div>
        <div class="product-price">$800 MXN</div>
        <button class="btn" onclick="addToCart('Cool T-Shirt',800)">Add to Cart</button>
      </div>
    </div>
    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1549924231-f129b911e442?ixlib=rb-4.0.4&auto=format&fit=crop&w=600&q=80" class="product-img" alt="Stylish T-Shirt"/>
      <div class="product-info">
        <div class="product-title">Stylish T-Shirt</div>
        <div class="product-price">$900 MXN</div>
        <button class="btn" onclick="addToCart('Stylish T-Shirt',900)">Add to Cart</button>
      </div>
    </div>
  </div>
  <div style="text-align:center; margin-top:30px;">
    <button class="btn" onclick="goTo('cart')">View Cart</button>
  </div>
</div>

<!-- CART PAGE -->
<div id="cart" class="page">
  <h2>Your Cart</h2>
  <div id="cartItems"></div>
  <div id="cartSummary"></div>
  <button class="btn" onclick="goTo('checkout1')">Checkout</button>
  <button class="btn" onclick="goTo('product')">Continue Shopping</button>
</div>

<!-- CHECKOUT FORM -->
<div id="checkout1" class="page">
  <h2>Shipping Information</h2>
  <input id="firstName" placeholder="First Name" />
  <input id="lastName" placeholder="Last Name" />
  <input id="email" placeholder="Email" />
  <input id="phone" placeholder="Phone" />
  <input id="address" placeholder="Address" />
  <input id="city" placeholder="City" />
  <input id="zip" placeholder="Zip Code" />
  <select id="shipping">
    <option value="200">Standard Shipping - $200 MXN</option>
  </select>
  <button class="btn" onclick="saveInfo()">Pay Now</button>
  <button class="btn" onclick="goTo('cart')">Back to Cart</button>
</div>

<!-- PAYMENT DETAILS -->
<div id="checkout2" class="page">
  <h2>Payment Details</h2>
  <input placeholder="Card Number xxxx-xxxx-xxxx-xxxx" />
  <input placeholder="Exp Month 01" />
  <input placeholder="Exp Year 2026" />
  <input placeholder="Security Code 123" />
  <h3>Order Summary</h3>
  <div id="summary"></div>
  <!-- FIXED: onclick should be completeOrder -->
  <button class="btn" onclick="completeOrder()">Complete Purchase</button>

 
</div>


  <button class="btn" onclick="goTo('checkout1')">Back</button>
</div>

<!-- THANK YOU PAGE -->
<div id="thankyou" class="page">
  <h2>Thank You!</h2>
  <div id="finalSummary"></div>
  <button class="btn" onclick="goTo('product')">Shop More</button>
</div>

<script>
function goTo(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById(page).classList.add('active');
  if(page==='cart') loadCart();
  if(page==='checkout2') loadSummary();
  if(page==='thankyou') loadFinalSummary();
}

function trackGA(event, params={}) { if(typeof gtag==='function') gtag('event', event, params); }

function addToCart(name, price) {
  let cart = JSON.parse(localStorage.getItem('cart')) || [];
  cart.push({name, price, qty:1});
  localStorage.setItem('cart', JSON.stringify(cart));
  alert('Added to cart!');
  trackGA('add_to_cart',{currency:'MXN', value:price, items:[{item_name:name, quantity:1, price:price}]});
}

function loadCart() {
  const cart = JSON.parse(localStorage.getItem('cart'))||[];
  let html=''; let subtotal=0;
  cart.forEach((item,index)=>{
    html+=`<div><span>${item.name} - $${item.price} MXN</span><button onclick="removeFromCart(${index})"><i class="fas fa-trash"></i></button></div>`;
    subtotal+=item.price;
  });
  const shipping=200; const total=subtotal+shipping;
  localStorage.setItem('total', total);
  document.getElementById('cartItems').innerHTML=html;
  document.getElementById('cartSummary').innerHTML=`<h3>Subtotal: $${subtotal} MXN</h3><h3>Shipping: $${shipping} MXN</h3><h2>Total: $${total} MXN</h2>`;
}

function removeFromCart(index){
  let cart = JSON.parse(localStorage.getItem('cart'))||[];
  cart.splice(index,1);
  localStorage.setItem('cart', JSON.stringify(cart));
  loadCart();
}

function saveInfo(){
  const user={
    firstName:document.getElementById('firstName').value,
    lastName:document.getElementById('lastName').value,
    name:document.getElementById('firstName').value+' '+document.getElementById('lastName').value,
    email:document.getElementById('email').value,
    phone:document.getElementById('phone').value,
    address:document.getElementById('address').value,
    city:document.getElementById('city').value,
    zip:document.getElementById('zip').value,
    shippingCost:Number(document.getElementById('shipping').value)
  };
  localStorage.setItem('user', JSON.stringify(user));
  trackGA('begin_checkout',{currency:'MXN', value:localStorage.getItem('total'), items:(JSON.parse(localStorage.getItem('cart'))||[]).map(i=>({item_name:i.name, quantity:i.qty, price:i.price}))});
  goTo('checkout2');
}

function loadSummary(){
  const cart=JSON.parse(localStorage.getItem('cart'))||[];
  const user=JSON.parse(localStorage.getItem('user'))||{};
  const subtotal=cart.reduce((s,i)=>s+i.price,0);
  const shipping=user.shippingCost||200;
  const total=subtotal+shipping;
  document.getElementById('summary').innerHTML=`
    <p><strong>Item:</strong> ${cart[0]?.name||'T-Shirt'}</p>
    <p><strong>Subtotal:</strong> $${subtotal} MXN</p>
    <p><strong>Shipping:</strong> $${shipping} MXN</p>
    <h3>Total: $${total} MXN</h3>
    <hr>
    <h4>Billing</h4>
    <p>Name: ${user.name}</p>
    <p>Email: ${user.email}</p>
    <h4>Shipping</h4>
    <p>${user.address}</p>
    <p>${user.city}, ${user.zip}</p>
    <p>Phone: ${user.phone}</p>
  `;
}

function loadFinalSummary(){
  const cart=JSON.parse(localStorage.getItem('cart'))||[];
  const user=JSON.parse(localStorage.getItem('user'))||{};
  const subtotal=cart.reduce((s,i)=>s+i.price,0);
  const shipping=user.shippingCost||200;
  const total=subtotal+shipping;
  document.getElementById('finalSummary').innerHTML=`
    <h2>Order Summary</h2>
    <p><strong>${cart[0]?.name||'T-Shirt'}</strong></p>
    <p>Quantity: 1</p>
    <p>Subtotal: $${subtotal} MXN</p>
    <p>Shipping: $${shipping} MXN</p>
    <p>Total: $${total} MXN</p>
    <hr>
    <h4>Billing</h4>
    <p>Name: ${user.name}</p>
    <p>Email: ${user.email}</p>
    <h4>Shipping</h4>
    <p>${user.address}</p>
    <p>${user.city}, ${user.zip}</p>
    <p>Phone: ${user.phone}</p>
    <hr>
    <p><strong>Payment:</strong> Card ending in ****</p>
  `;
}
</script>

<script>
function sendSaleNotification(user, cart, total){
  const templateParams = {
    customer_name: user.name,
    email: user.email,
    phone: user.phone,
    address: user.address,
    city: user.city,
    zip: user.zip,
    items: cart.map(i => i.name + ' x' + i.qty).join(', '),
    total: total
  };

  // Replace these with your actual EmailJS Service & Template IDs
emailjs.send('service_80xd72k', 'template_cga2o68', templateParams)
  .then(res => console.log('Notification sent', res.status, res.text))
  .catch(err => console.error('Notification error', err));
}



 
 
function completeOrder() {
  let cart = JSON.parse(localStorage.getItem('cart')) || [];
  let user = JSON.parse(localStorage.getItem('user')) || {};
  const subtotal = cart.reduce((s, i) => s + i.price * i.qty, 0); // fixed here
  const shipping = user.shippingCost || 200;
  const total = subtotal + shipping;


  let subtotal = 800;       // fixed product price
  let tax = 0;              // no tax
  let shipping = 200;       // fixed shipping
  let total = subtotal + tax + shipping;

  // Send GA4 purchase event
  trackGA('purchase', {
    currency: 'MXN',
    value: total,
    shipping: shipping,
    items: cart.map(item => ({
      item_name: item.name,
      quantity: item.qty,
      price: item.price
    })),
    transaction_id: 'TXN-' + Date.now()
  });

  // Send sale notification email
  sendSaleNotification(user, cart, total);

  // Show thank-you page
  goTo('thankyou');

  // Clear localStorage after page render
  setTimeout(() => localStorage.clear(), 1000);
}


</script>

<!-- EmailJS SDK -->
<script type="text/javascript" src="https://cdn.emailjs.com/sdk/3.2.0/email.min.js"></script>
<script>
  emailjs.init('AUtQm-ty0okqVLQoz'); // Public Key only
</script>



<footer>&copy; 2026 My Shop</footer>
</body>
</html>
