<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Placoso Studio</title>
<!-- Estilos básicos -->
<style>
body {
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  margin: 0;
  background-color: #222;
  color: #fff;
}

/* Encabezado estilo similar a ejemplo */
.header-top {
  background-color: #222;
  display: flex;
  align-items: center;
  padding: 10px 20px;
  justify-content: space-between;
  flex-wrap: wrap;
}

/* Logo y branding */
.logo-container {
  display: flex;
  align-items: center;
}
.logo-img {
  max-height: 50px;
  margin-right: 10px;
}
.logo-text {
  font-size: 24px;
  font-weight: bold;
  color: #00f;
}

.menu-items {
  display: flex;
  align-items: center;
  gap: 15px;
}
.menu-items a {
  color: #00f;
  text-decoration: none;
  font-weight: 600;
}
.menu-items a:hover {
  text-decoration: underline;
}

/* Menú principal estilo similar */
.navbar {
  background-color: #333;
  display: flex;
  flex-wrap: wrap;
  padding: 10px 20px;
}
.nav-menu {
  display: flex;
  list-style: none;
  flex: 1;
  margin: 0;
  padding: 0;
}
.nav-item {
  position: relative;
  margin-right: 20px;
}
.nav-link {
  color: #fff;
  text-decoration: none;
  padding: 8px 12px;
  font-weight: 600;
  cursor: pointer;
}
.nav-link:hover,
.nav-item:hover > .nav-link {
  background-color: #444;
}
.submenu {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  background-color: #555;
  list-style: none;
  padding: 0;
  margin: 0;
  min-width: 200px;
  z-index: 999;
}
.submenu li {
  width: 100%;
}
.submenu li a {
  display: block;
  padding: 10px 15px;
  color: #fff;
  text-decoration: none;
}
.submenu li a:hover {
  background-color: #666;
}
.nav-item:hover > .submenu {
  display: block;
}

/* Estilo para iconos y otros elementos */
.icon {
  width: 20px;
  height: 20px;
  vertical-align: middle;
  fill: #fff;
  margin-right: 8px;
}

/* Responsividad básica */
@media(max-width: 768px){
  .header-top {
    flex-direction: column;
    align-items: flex-start;
  }
  .menu-items {
    width: 100%;
    margin-top: 10px;
  }
  .navbar {
    flex-direction: column;
  }
  .nav-menu {
    flex-direction: column;
  }
  .nav-item {
    margin-right: 0;
  }
  .submenu {
    position: static;
  }
}
</style>
<!-- Scripts para dropdown -->
<script>
document.querySelectorAll('.nav-item').forEach(function(item) {
  item.addEventListener('mouseover', function() {
    const submenu = item.querySelector('.submenu');
    if (submenu) {
      submenu.style.display = 'block';
    }
  });
  item.addEventListener('mouseout', function() {
    const submenu = item.querySelector('.submenu');
    if (submenu) {
      submenu.style.display = 'none';
    }
  });
});
</script>
</head>
